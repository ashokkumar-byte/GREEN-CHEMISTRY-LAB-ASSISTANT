# Required in production
SECRET_KEY=replace-with-a-long-random-value
# Optional absolute path for a persistent SQLite volume, e.g. /var/data/green_chemistry.db on Render
DATABASE_PATH=

# Optional external AI provider
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# Optional admin bootstrap; no admin is created when ADMIN_PASSWORD is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com
